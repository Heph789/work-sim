# Copy to .env and fill in. The API reads these on boot.

# Which LLM provider createLLMClient() instantiates. 'openai' is the v1 default;
# 'anthropic' is reserved (not implemented in v1).
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Reserved — required when LLM_PROVIDER=anthropic (future).
# ANTHROPIC_API_KEY=

# Fastify port. Defaults to 4000 if unset.
PORT=4000

# SQLite database file path. Relative to the api package's cwd.
DATABASE_URL=./work-sim.db
