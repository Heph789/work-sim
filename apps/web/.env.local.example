# Copy to .env.local. Read once at module load by lib/api.ts.
# `NEXT_PUBLIC_` prefix is required for Next.js to expose the var to the browser.

# Mock mode (default). When unset OR set to anything other than 'false', the
# frontend talks to the same-origin Next route handlers under /api, backed by
# the in-memory mock store in apps/web/lib/mock/. No real backend needed.
NEXT_PUBLIC_USE_MOCK=true

# Real-backend mode. Set NEXT_PUBLIC_USE_MOCK=false to hit a Fastify API:
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_URL=http://localhost:4000
