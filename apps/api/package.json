{
  "//": "Fastify HTTP server + in-process simulation engine. Imports @work-sim/shared via the tsconfig path alias (no publish step). Cross-package linkage: a `file:` link to packages/shared so node_modules resolves it; the tsconfig alias remains the source of truth for type-checking.",
  "name": "@work-sim/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@work-sim/shared": "file:../../packages/shared",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.27.0",
    "openai": "^4.55.0",
    "seedrandom": "^3.0.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.12.0",
    "@types/seedrandom": "^3.0.8",
    "@types/uuid": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
